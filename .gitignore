# MATLAB codegen build artifacts. Generated CUDA source for the two live
# GPU Coder targets is committed so the WSL2 .so can be built without MATLAB.
MATLAB Codes/codegen/*
!MATLAB Codes/codegen/lib/
MATLAB Codes/codegen/lib/*
!MATLAB Codes/codegen/lib/aline_reconstruct/
!MATLAB Codes/codegen/lib/das_beamform_planewave/
MATLAB Codes/codegen/lib/*/*
!MATLAB Codes/codegen/lib/*/*.cu
!MATLAB Codes/codegen/lib/*/*.h
!MATLAB Codes/codegen/lib/*/*.cpp
!MATLAB Codes/codegen/lib/*/*.hpp
*.slxc
slprj/

# MATLAB autosave / temp
*.asv
*.m~

# Python
__pycache__/
*.pyc
venv/
*.egg-info/

# Pipeline run outputs (regenerated each run, not source)
Holoscan/pipeline_results.npy
Holoscan/results/

# Intermediate artifacts (regenerated by scripts, not needed for reproducibility)
MATLAB Codes/bmode_enhanced.mat

# Word lock files
~$*.doc*

# OS files
.DS_Store
Thumbs.db

# Full datasets (only data/sample/ is committed)
data/full/

# RESULTS_DIR duplicates and caches (committed copies of the model and split
# live in MATLAB Codes/, the plane-wave sample in data/sample/planewave/)
results/trainedMobileNetV2_mega.*
results/cnn_split.mat
results/simulink_cache/
results/planewave_sample/
